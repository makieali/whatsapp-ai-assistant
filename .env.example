# Copy to .env and fill in. NEVER commit your real .env.

# ---- LLM provider: set ONE block ----
# Option A: standard OpenAI
OPENAI_API_KEY=sk-your-key-here
MODEL=gpt-4o-mini
# Whisper model for voice-note transcription
TRANSCRIBE_MODEL=whisper-1

# Option B: Azure OpenAI (takes priority if AZURE_OPENAI_API_KEY is set)
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
# AZURE_OPENAI_DEPLOYMENT=your-vision-chat-deployment

# ---- WhatsApp Cloud API ----
# From your Meta app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# You choose this string; enter the same value in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token
# App Secret (Meta app -> Settings -> Basic) -- enables request signature checks
WHATSAPP_APP_SECRET=your-app-secret

# ---- App ----
SECRET_KEY=change-me
FLASK_DEBUG=false
PORT=5060
# Max conversation turns kept in memory per user
MAX_HISTORY_TURNS=12
